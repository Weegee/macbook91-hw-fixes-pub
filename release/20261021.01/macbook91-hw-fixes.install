# SPDX-License-Identifier: GPL-3.0-or-later
# The only live change: d3cold_allowed=0 on the Apple NVMe, which the packaged
# udev rule sets at every boot anyway; this makes it hold before the next
# suspend. Changes to files the package does not own (/etc/default/limine,
# /etc/modprobe.d) are made by `macbook91-hw-migrate apply`, which backs them
# up and can undo them.

_nvme_d3cold() {
    [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = "MacBook9,1" ] || return 0
    for d in /sys/bus/pci/devices/*; do
        [ "$(cat "$d/vendor" 2>/dev/null)" = 0x106b ] && [ "$(cat "$d/device" 2>/dev/null)" = 0x2003 ] &&
            echo 0 >"$d/d3cold_allowed" 2>/dev/null
    done
    return 0
}

# DKMS builds the applesmc replacement (charge limit) during the transaction
# for every kernel series it has a source for; the running in-tree applesmc
# stays until it is reloaded or the next boot.
_applesmc_hint() {
    [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = "MacBook9,1" ] || return 0
    [ -e /sys/class/power_supply/BAT0/charge_control_end_threshold ] && return 0
    _s=$(uname -r | sed -n 's/^\([0-9]*\.[0-9]*\)\..*/\1/p')
    for _f in /usr/src/macbook91-applesmc-*/"$_s"/applesmc.c; do
        if [ -n "$_s" ] && [ -e "$_f" ]; then
            echo ":: macbook91-hw-fixes: the charge limit (applesmc with SMC key BCLM) takes effect after a reboot"
            echo "   or now with 'sudo modprobe -r applesmc && sudo modprobe applesmc'."
            return 0
        fi
    done
    echo ":: macbook91-hw-fixes: no applesmc source for Linux ${_s:-?}; on this kernel the charge limit"
    echo "   cannot be changed (a limit set earlier may still apply). Kernels with a source: see README."
}

post_install() {
    _nvme_d3cold
    _applesmc_hint
    echo ":: macbook91-hw-fixes: review with 'macbook91-hw-migrate plan', apply with"
    echo "   'sudo macbook91-hw-migrate apply' (backups, 'rollback' undoes), then reboot."
    echo "   ISO keyboard (German and most European layouts): 'sudo macbook91-hw-migrate apply keyboard-iso'."
    echo "   Check the machine with 'macbook91-hw-verify' (--deep adds the audio, camera and wireless checks, where installed)."
}

post_upgrade() {
    _nvme_d3cold
    _applesmc_hint
    if command -v macbook91-hw-migrate >/dev/null && macbook91-hw-migrate plan 2>/dev/null | grep -q '^would apply'; then
        echo ":: macbook91-hw-fixes: new migration steps are pending: 'macbook91-hw-migrate plan'"
    fi
}

pre_remove() {
    # The SMC keeps BCLM across reboots and OSes; without the package nothing
    # could lift a limit again, so removal restores full charging.
    _t=/sys/class/power_supply/BAT0/charge_control_end_threshold
    if [ -w "$_t" ] && [ "$(cat "$_t" 2>/dev/null)" != 100 ]; then
        if echo 100 >"$_t" 2>/dev/null; then
            echo ":: macbook91-hw-fixes: charge limit reset to 100 % (the SMC would keep it after removal)"
        else
            echo ":: macbook91-hw-fixes: could not reset the charge limit to 100 %; it stays at $(cat "$_t" 2>/dev/null) %"
        fi
    elif [ ! -e "$_t" ] && [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = "MacBook9,1" ]; then
        echo ":: macbook91-hw-fixes: this kernel runs in-tree applesmc, so the charge limit was not reset."
        echo "   If one below 100 % was set, the SMC may keep it: reinstall the package, boot a kernel it"
        echo "   has a source for, run 'echo 100 | sudo tee $_t', then remove the package."
    fi
    echo ":: macbook91-hw-fixes: without the package the NVMe udev rule is gone; from the next boot"
    echo "   the NVMe root port may enter D3 during suspend again."
    if [ -d /var/lib/macbook91-hw-fixes/applied ] && [ -n "$(ls -A /var/lib/macbook91-hw-fixes/applied 2>/dev/null)" ]; then
        echo ":: macbook91-hw-fixes: applied migration steps stay in place after removal."
        echo "   To undo them first: 'sudo macbook91-hw-migrate rollback'. Backups remain in"
        echo "   /var/lib/macbook91-hw-fixes/ either way."
    fi
}
