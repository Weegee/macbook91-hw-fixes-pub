# Maintainer: Weegee <748975+Weegee@users.noreply.github.com>
#
# Hardware fixes for the Apple MacBook9,1 (A1534) outside audio, camera and
# wireless: a tool that sets the kernel parameter for the native backlight and,
# when named, two optional settings, the perceptual backlight and charge-limit
# DKMS modules, the NVMe udev rule, the lid sleep hook and a verify tool for the
# machine. It needs none of the driver packages. See README.md and docs/.

pkgbase=macbook91-hw-fixes
pkgname=(macbook91-hw-fixes)
pkgver=20261026.02
pkgrel=1
pkgdesc="Hardware fixes and checks for the Apple MacBook9,1 (A1534): backlight, charge limit, NVMe, lid wake"
arch=('any')
url='https://github.com/Weegee/macbook91-hw-fixes-pub'
# Tools, hook, udev rule, UPSTREAM.lock and docs are GPL-3.0-or-later, the
# modules' Makefiles and dkms.conf GPL-2.0-or-later (GPLv2 section 3), the
# module sources (macbook91_backlight.c, patched applesmc.c) GPL-2.0-only;
# README.md maps every path.
license=('GPL-3.0-or-later' 'GPL-2.0-or-later' 'GPL-2.0-only')

# make and patch, for package() (it applies the applesmc patch).
makedepends=('make' 'patch')

# One source: the reproducible tarball `make dist` writes to dist/. The
# checksum is pinned at release time; `make arch-pkg` refuses a tarball that
# does not match it.
source=("$pkgbase-$pkgver.tar")
sha256sums=('5e7e737057b575ec9e588061d866a152379b96d3957db6d8490721f02e08184c')

# Dependencies sit in package_*() as in the driver packages: makepkg does not
# check them at build time, so a build host without the CachyOS repositories
# can build the package, and the package still carries them. This package
# stands on its own: the audio, camera and wireless driver packages are
# separate and not required. The LTS kernel is the default: DKMS builds a
# module only for a kernel whose headers are installed, and
# linux-cachyos-lts-headers pulls in linux-cachyos-lts itself. Which kernel
# series the modules cover: kernel/applesmc/UPSTREAM.lock and
# kernel/TESTED-SERIES, reported by the pacman hook.
package_macbook91-hw-fixes() {
    depends=('bash' 'coreutils' 'findutils' 'grep' 'sed' 'systemd' 'dkms' 'linux-cachyos-lts-headers')
    optdepends=('linux-cachyos-headers: DKMS builds the modules for linux-cachyos as well'
                'limine-mkinitcpio-hook: lets macbook91-hw-migrate apply kernel parameters on Limine'
                'nvme-cli: lets macbook91-hw-verify read the NVMe health log (as root)')
    install="$pkgbase.install"

    cd "$pkgbase-$pkgver" || exit 1
    make PREFIX=/usr DESTDIR="$pkgdir" install
}
